{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/libexec/route Notification",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/libexec/route PostToolUse",
            "timeout": 32
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/libexec/route PostToolUseFailure",
            "timeout": 32
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|WebSearch|WebFetch|mcp__visualize__show_widget",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/libexec/route PreToolUse",
            "timeout": 602,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/libexec/route SessionStart",
            "timeout": 32
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/libexec/route CwdChanged",
            "timeout": 32
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/libexec/route Stop",
            "timeout": 122
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/libexec/route TaskCompleted",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/libexec/route UserPromptSubmit",
            "timeout": 32
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/libexec/route StopFailure",
            "timeout": 32
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/libexec/route SessionEnd",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
