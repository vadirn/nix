{
  "route": {
    "log": {
      "retention_days": 30,
      "max_input_chars": 500,
      "max_output_chars": 2000
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/sound.sh Notification",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/hint-autoformat.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/turn-check.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/turn-check.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/no-secrets.sh"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/no-dangerous-rm.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/no-dangerous.py"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/quiet-override.sh"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/pipe-allow.py"
          },
          {
            "type": "command",
            "command": "~/.local/bin/trinket-git-message",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/rg-glob-guard.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/no-secrets-read.sh"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/no-secrets-read.sh"
          }
        ]
      },
      {
        "matcher": "^(WebSearch|WebFetch)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/prefer-firecrawl.sh"
          }
        ]
      },
      {
        "matcher": "^mcp__visualize__show_widget$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/chart-verbatim.py"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/turn-check.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p /tmp/claude",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/sandbox-nc-path.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/direnv-env.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/direnv-env.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/sound.sh Stop",
            "timeout": 5,
            "async": true
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/stop-verify.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/sound.sh TaskCompleted",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/turn-check.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "/Users/vadim/.local/bin/trinket-claude-prompt --config /Users/vadim/.config/trinket/turn-prompt.json",
            "timeout": 30
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/turn-check.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/turn-check.sh",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
