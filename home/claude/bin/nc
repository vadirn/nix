#!/usr/bin/env bash
set -euo pipefail

if [[ "$#" -ge 6 ]] \
  && [[ "$1" == "-X" && "$2" == "5" && "$3" == "-x" ]] \
  && [[ "${ALL_PROXY:-}" == *"@"* ]] \
  && [[ "$4" == "${ALL_PROXY##*@}" ]] \
  && command -v ncat >/dev/null 2>&1; then
  _auth="${ALL_PROXY#*://}"
  _auth="${_auth%@*}"
  _proxy="127.0.0.1:${4##*:}"
  NCAT_PROXY_AUTH="$_auth" exec ncat --proxy-type socks5 --proxy "$_proxy" "${@: -2}"
fi

exec /usr/bin/nc "$@"
