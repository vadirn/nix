{
  "skillListingBudgetFraction": 0.015,
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_EXPERIMENTAL_CODE_MODE": "1",
    "ENABLE_TOOL_SEARCH": "auto:5",
    "MAX_STRUCTURED_OUTPUT_RETRIES": "3",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "BASECAMP_NO_KEYRING": "1",
    "BASECAMP_HINTS": "false",
    "BASECAMP_STATS": "false",
    "CLAUDE_CODE_WORKFLOWS": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/nix/home/claude/plugins/context-meter"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Skill(playground)",
      "Skill(tdd)",
      "Skill(debate)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git ls-tree *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git remote *)",
      "Bash(git tag *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh repo view *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh pr create *)",
      "Skill(vault)",
      "Bash(ls *)",
      "Bash(date *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(which *)",
      "Bash(file *)",
      "Bash(readlink *)",
      "Bash(jq *)",
      "Bash(base64 *)",
      "Bash(ps *)",
      "Bash(stat *)",
      "Bash(echo *)",
      "Read"
    ],
    "deny": [],
    "defaultMode": "auto"
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/hooky Notification",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/hooky PostToolUse",
            "timeout": 7
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|WebSearch|WebFetch|mcp__visualize__show_widget",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/hooky PreToolUse",
            "timeout": 602,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/hooky SessionStart",
            "timeout": 32
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/hooky CwdChanged",
            "timeout": 32
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/hooky Stop",
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/hooky TaskCompleted",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "outputStyle": "Simplified",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "mcp-proxy.anthropic.com",
        "downloads.claude.ai",
        "raw.githubusercontent.com",
        "browser-intake-datadoghq.com",
        "http-intake.logs.datadoghq.com",
        "api.firecrawl.dev",
        "github.com",
        "api.github.com",
        "lfs.github.com",
        "crates.io",
        "static.crates.io",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "api.doppler.com",
        "cli.doppler.com",
        "generativelanguage.googleapis.com",
        "api.fireworks.ai",
        "dashscope-intl.aliyuncs.com",
        "api.openai.com",
        "fal.run",
        "*.fal.run",
        "*.fal.media",
        "*.fal.ai",
        "*.localhost"
      ],
      "allowManagedDomainsOnly": false,
      "allowAllUnixSockets": true,
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/.bun",
        "~/.cache",
        "~/.cargo",
        "~/.config/basecamp",
        "~/.docker",
        "~/.gnupg",
        "~/Documents/vault",
        "~/Library/Application Support/Ledger",
        "~/nix",
        "~/Pictures/imagen",
        "~/Pictures/vidgen",
        "$TMPDIR"
      ],
      "denyRead": [
        "~/.ssh"
      ],
      "allowRead": [
        "~/.ssh/*.pub",
        "~/.ssh/known_hosts",
        "~/.ssh/allowed_signers"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.netrc",
          "mode": "deny"
        },
        {
          "path": "~/.claude/.credentials.json",
          "mode": "deny"
        }
      ]
    },
    "enableWeakerNetworkIsolation": true
  },
  "syntaxHighlightingDisabled": false,
  "alwaysThinkingEnabled": true,
  "plansDirectory": "./.claude-plans",
  "autoDreamEnabled": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "advisorModel": "fable"
}
